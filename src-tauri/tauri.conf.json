{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soocial",
  "version": "1.0.0",
  "identifier": "com.soocial.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "url": "renderer/index.html",
        "title": "Soocial",
        "width": 1400,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#16161f",
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "One window for all your web apps, each account in its own isolated session.",
    "longDescription": "Soocial is a desktop shell for web apps such as WhatsApp, Discord, Slack, Gmail and more. Each service keeps its own session, volume, badges and notifications.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
